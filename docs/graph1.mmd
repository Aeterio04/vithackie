---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	explore(explore)
	plan(plan)
	review_gate(review_gate)
	__end__([<p>__end__</p>]):::last
	__start__ --> explore;
	explore -. &nbsp;failed&nbsp; .-> __end__;
	explore -. &nbsp;ok&nbsp; .-> plan;
	plan -. &nbsp;failed&nbsp; .-> __end__;
	plan -. &nbsp;ok&nbsp; .-> review_gate;
	review_gate --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
