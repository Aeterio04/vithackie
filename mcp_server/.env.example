# Backend base URL (no trailing slash needed)
KAWACH_BASE_URL=http://localhost:8000
# Option 1 (recommended): the SAME email/password you registered on the KAWACH website.
# Everything started through the MCP then appears on that account's dashboard.
KAWACH_EMAIL=
KAWACH_PASSWORD=
# Option 2: personal API token (kw_live_...) or an existing JWT. If set, login is skipped.
# Create the token with scopes runs:read, runs:write, tests:read, tests:write.
KAWACH_TOKEN=
KAWACH_TIMEOUT_SECONDS=30
KAWACH_DOWNLOAD_DIR=./kawach_downloads
KAWACH_LOG_LEVEL=INFO
