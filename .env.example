# ==============================================================================
# KAWACH: Autonomous AI QA Engineer Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Settings
# ------------------------------------------------------------------------------
ENV=development                      # development | staging | production
DEBUG=true                           # true | false
LEGACY_ROUTES=true                   # true: dual-mount legacy endpoints alongside /api/v1/*

# ------------------------------------------------------------------------------
# 2. Database Connection
# ------------------------------------------------------------------------------
# SQLite default for local testing; use postgresql://user:pass@host:5432/kawach in prod
DATABASE_URL=sqlite:///data/kawach.db

# ------------------------------------------------------------------------------
# 3. Authentication & Sessions
# ------------------------------------------------------------------------------
# Secret key used for signing JWT tokens. In production, provide a strong 32+ char secret.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOW_SIGNUP=true                    # Allow open registration; set false in enterprise deployments

# ------------------------------------------------------------------------------
# 4. Storage & Persistence
# ------------------------------------------------------------------------------
RUNS_DIR=runs                        # Directory for temporary run execution bundles
ARTIFACTS_DIR=data/artifacts         # Managed artifact store root for media, traces, logs

# ------------------------------------------------------------------------------
# 5. Security & Network Sandboxing
# ------------------------------------------------------------------------------
# 32-byte urlsafe base64-encoded key for encrypting credentials at rest (Fernet)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1    # Comma-separated allowed target hostnames for crawler

# ------------------------------------------------------------------------------
# 6. LLM Engine & Provider
# ------------------------------------------------------------------------------
LLM_PROVIDER=anthropic               # anthropic | openai | groq | fake
LLM_MODEL=claude-sonnet-5-5          # Model identifier
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
LLM_PRICE_IN_PER_MTOK=0.0            # USD per million input tokens
LLM_PRICE_OUT_PER_MTOK=0.0           # USD per million output tokens
LLM_CACHE=on                         # on | off | readonly
STUB_MODE=0                          # 1 = simulate all stages with contract samples (no LLM, no browser)

# ------------------------------------------------------------------------------
# 7. Runner & Exploration Limits
# ------------------------------------------------------------------------------
MAX_PAGES=10                         # Crawler BFS exploration page limit
EXPLORE_SECONDS=90                   # Crawler max wall-clock duration in seconds
MAX_TESTS=12                         # Test catalog generation max planned items
TEST_TIMEOUT_MS=30000                # Playwright execution timeout per test in milliseconds
VERIFY_PARALLEL=1                    # Parallel replay workers (keep 1 for deterministic flakiness testing)
BUGS_OFF=                            # Target app planted defect disabling (e.g. GT01,GT03 or all)

# ------------------------------------------------------------------------------
# 8. GitHub Integration & Webhooks
# ------------------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=               # Secret used to verify GitHub HMAC-SHA256 webhook signatures
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 9. Automated Fix Policies
# ------------------------------------------------------------------------------
FIX_POLICY_MAX_FILES=1               # Maximum files allowed in an auto-fix PR
FIX_POLICY_MAX_LINES=50              # Maximum total diff lines allowed in an auto-fix PR
FIX_POLICY_FORBIDDEN_PATHS=auth,payment,migrations  # Paths strictly forbidden from auto-fixing
