[importlinter]
root_package = kawach

[importlinter:contract:1]
name = Layered Architecture Contract
type = layers
layers =
    kawach.api
    kawach.services
    kawach.workflows
    kawach.agents
    kawach.execution
    kawach.integrations
    kawach.repositories
    kawach.llm
    kawach.storage
    kawach.db
    kawach.schemas
    kawach.domain
    kawach.core

[importlinter:contract:2]
name = Agents Independence Contract
type = forbidden
source_modules =
    kawach.agents
forbidden_modules =
    kawach.api
    kawach.services
    kawach.db
    kawach.repositories
    kawach.integrations

[importlinter:contract:3]
name = Workflows Independence Contract
type = forbidden
source_modules =
    kawach.workflows
forbidden_modules =
    kawach.api

[importlinter:contract:4]
name = Domain Independence Contract
type = forbidden
source_modules =
    kawach.domain
forbidden_modules =
    kawach.api
    kawach.services
    kawach.workflows
    kawach.agents
    kawach.execution
    kawach.integrations
    kawach.repositories
    kawach.llm
    kawach.storage
    kawach.db
    kawach.schemas

[importlinter:contract:5]
name = Schemas Independence Contract
type = forbidden
source_modules =
    kawach.schemas
forbidden_modules =
    kawach.api
    kawach.services
    kawach.workflows
    kawach.agents
    kawach.execution
    kawach.integrations
    kawach.repositories
    kawach.llm
    kawach.storage
    kawach.db

