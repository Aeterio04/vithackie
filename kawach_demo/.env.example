# GitHub Personal Access Token (Fine-grained PAT with Contents RW & Pull Requests RW, or Classic PAT with repo scope)
GITHUB_PAT=github_pat_xxxxxxxxxxxxxxxxxxxx

# Target demo repository in format "owner/repo" (branch protection must be OFF)
DEMO_REPO=your-github-username/kawach-demo-shop

# Absolute path to local clone of DEMO_REPO (same folder running 'node --watch src/server.js')
APP_CLONE_PATH=C:/projects/target-app/kawach-demo-shop

# Target application HTTP URL served by local dev server (default: http://localhost:3000)
TARGET_URL=http://localhost:3000

# LLM API Keys (at least one is required; Groq is primary, Gemini is fallback)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxx

# Optional: Directory where pipeline execution artifacts and logs are persisted
KAWACH_FIX_RUNS_DIR=./fix_runs
